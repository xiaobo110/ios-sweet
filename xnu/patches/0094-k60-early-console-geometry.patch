--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -13,9 +13,14 @@
 
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+/* Panel geometry. This fork targets the Redmi K50 Ultra (diting, SM8475): 1220x2712 with a
+ * 4880-byte stride. The sweet constants (1080x2400, 4320) drew every early
+ * mark and every early string with the wrong stride here, which is why the
+ * bootstrap console looked like an untouched (red) shim screen while the
+ * kernel was actually making progress. */
+#define EARLY_WIDTH 1220u
+#define EARLY_HEIGHT 2712u
+#define EARLY_STRIDE (4880u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -93,7 +98,7 @@
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
-	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+	for (unsigned int y = EARLY_HEIGHT - 160; y < EARLY_HEIGHT - 128; y++) {
 		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
 		}
